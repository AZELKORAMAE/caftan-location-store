# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : uniquement pour le script create-admin (ne jamais l'exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (liens des e-mails, images des e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Devise affichée (code ISO 4217)
NEXT_PUBLIC_CURRENCY=MAD

# Compte administrateur créé par `npm run create-admin`
# (même adresse que dans supabase/schema.sql)
ADMIN_EMAIL=admin@darlalla.ma
ADMIN_PASSWORD=

# E-mails de confirmation de réservation (mot de passe d'application Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Dar Lalla
